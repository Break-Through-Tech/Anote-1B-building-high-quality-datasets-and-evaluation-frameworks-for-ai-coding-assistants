# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is gitignored. NEVER commit real keys.
# If a key is ever pushed, revoke it immediately — deleting the commit is not enough.

# Anthropic (Claude baselines) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT baselines) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Hugging Face token, only needed for gated datasets/models
HF_TOKEN=
